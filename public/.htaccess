<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Conserver les vrais fichiers et dossiers (images, CSS, JavaScript, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Laisser React Router gérer toutes les pages de l'application.
  RewriteRule ^ index.html [L]
</IfModule>

ErrorDocument 404 /index.html