<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Une seule adresse pour le site : www.blade-hairstyle.com renvoie (301) vers
  # blade-hairstyle.com, en gardant le chemin et les paramètres. Le domaine cible
  # est écrit en dur pour ne jamais rediriger vers un hôte fourni par la requête.
  RewriteCond %{HTTP_HOST} ^www\.blade-hairstyle\.com\.?(:[0-9]+)?$ [NC]
  RewriteRule ^ https://blade-hairstyle.com%{REQUEST_URI} [R=301,L]

  # Le dossier public/blade (images, vidéo, manifeste) porte le même nom que la
  # page /blade. Sans ces deux lignes, Apache ajoute un « / » puis refuse de
  # lister le dossier : un rafraîchissement sur /blade renvoyait une erreur 403.
  DirectorySlash Off
  Options -Indexes

  # Servir tels quels uniquement les vrais fichiers (images, CSS, JavaScript…).
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Toutes les autres adresses, dossiers compris, sont des pages React Router.
  RewriteRule ^ index.html [L]
</IfModule>

# En-têtes de sécurité : pas d'affichage du site dans un cadre d'un autre site
# (clickjacking), pas de devinette de type de fichier, HTTPS imposé, et
# micro coupé (caméra pour scanner les cartes de fidélité et géolocalisation pour « autour de moi » restent permises).
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(self)"
</IfModule>

ErrorDocument 403 /index.html
ErrorDocument 404 /index.html
